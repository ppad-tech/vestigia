+/* Check the supplied *original* atoms, the operands of an integer
+   division, for undefinedness, and emit a complaint for each that is
+   undefined.  A division takes a time that depends on its operands,
+   so an undefined operand is reported as its own kind of error
+   (Err_Operand), apart from a value used as an address or a
+   condition.  Unlike complainIfUndefined, the atoms are not then
+   marked defined: the quotient carries its operands' undefinedness
+   on, as it would had nothing been reported. */
+static void complainIfOperandsUndefined ( MCEnv* mce,
+                                          IRAtom* atom1, IRAtom* atom2 )
+{
+   IRAtom* atoms[2] = { atom1, atom2 };
+   Int     k;
+
+   if (MC_(clo_mc_level) == 1)
+      return;
+
+   for (k = 0; k < 2; k++) {
+      IRAtom*  vatom;
+      IRAtom*  origin;
+      IRDirty* di;
+
+      tl_assert(isOriginalAtom(mce, atoms[k]));
+      vatom = expr2vbits( mce, atoms[k], HuOth );
+      tl_assert(isShadowAtom(mce, vatom));
+
+      if (MC_(clo_mc_level) == 3) {
+         origin = schemeE( mce, atoms[k] );
+         if (mce->hWordTy == Ity_I64) {
+            origin = assignNew( 'B', mce, Ity_I64,
+                                unop(Iop_32Uto64, origin) );
+         }
+         di = unsafeIRDirty_0_N(
+                 1, "MC_(helperc_operand_check_fail_w_o)",
+                 VG_(fnptr_to_fnentry)(
+                    &MC_(helperc_operand_check_fail_w_o) ),
+                 mkIRExprVec_1(origin) );
+      } else {
+         di = unsafeIRDirty_0_N(
+                 0, "MC_(helperc_operand_check_fail_no_o)",
+                 VG_(fnptr_to_fnentry)(
+                    &MC_(helperc_operand_check_fail_no_o) ),
+                 mkIRExprVec_0() );
+      }
+      di->guard = mkPCastTo( mce, Ity_I1, vatom );
+      setHelperAnns( mce, di );
+      stmt( 'V', mce, IRStmt_Dirty(di) );
+   }
+}
