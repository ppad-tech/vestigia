cabal-version:      3.0
name:               vestigia
version:            0.2.0
synopsis:           Where an execution depended on a secret.
license:            MIT
license-file:       LICENSE
author:             Jared Tobin
maintainer:         jared@ppad.tech
category:           Testing
build-type:         Simple
tested-with:        GHC == 9.10.3
extra-doc-files:    CHANGELOG
description:
  vestigia runs a harness and reports every instruction that
  branched on a secret it marked, computed an address from it, or
  divided by or into it, naming each by function and source line.
  It has two instruments: taint tracking under valgrind's memcheck,
  and differential traces under QEMU, optionally checked against an
  ISA's data-independent-timing contract.

source-repository head
  type:     git
  location: git.ppad.tech/vestigia.git

library
  default-language: Haskell2010
  hs-source-dirs:   lib
  ghc-options:
      -Wall -Werror
  c-sources:
      cbits/norandom.c
  exposed-modules:
      Vestigia.Contract
    , Vestigia.Contract.Arm
    , Vestigia.Contract.Intel
    , Vestigia.Contract.Types
    , Vestigia.Diff
    , Vestigia.Json
    , Vestigia.Layout
    , Vestigia.Memcheck
    , Vestigia.Symbol
    , Vestigia.Trace
    , Vestigia.Xml
  build-depends:
      base >= 4.9 && < 5
    , bytestring >= 0.9 && < 0.13
    , containers >= 0.6 && < 1
    , directory >= 1.3 && < 2
    , process >= 1.6 && < 1.7
    , text >= 1.2 && < 2.2

executable vestigia
  default-language: Haskell2010
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:
      -Wall -Werror -rtsopts
  -- Setup builds this in dist/build/vestigia, which a case-insensitive
  -- filesystem merges with the library's dist/build/Vestigia; clang's
  -- preprocessor flags the case mismatch, and -Werror makes it fatal
  if os(osx)
    ghc-options: -optP-Wno-nonportable-include-path
  other-modules:
      Paths_vestigia
  autogen-modules:
      Paths_vestigia
  build-depends:
      base >= 4.9 && < 5
    , bytestring >= 0.9 && < 0.13
    , containers >= 0.6 && < 1
    , directory >= 1.3 && < 2
    , filepath >= 1.4 && < 2
    , process >= 1.6 && < 1.7
    , text >= 1.2 && < 2.2
    , vestigia

test-suite vestigia-tests
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   test
  main-is:          Main.hs
  ghc-options:
      -Wall -Werror -rtsopts
  build-depends:
      base >= 4.9 && < 5
    , bytestring >= 0.9 && < 0.13
    , containers >= 0.6 && < 1
    , directory >= 1.3 && < 2
    , filepath >= 1.4 && < 2
    , tasty >= 1.4 && < 2
    , tasty-hunit >= 0.10 && < 1
    , text >= 1.2 && < 2.2
    , vestigia
