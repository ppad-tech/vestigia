From f586b1456b5f154481db567da20bba724ec12cc1 Mon Sep 17 00:00:00 2001
From: Jared Tobin <jared@jtobin.io>
Date: Tue, 6 Oct 2026 11:44:42 +0400
Subject: [PATCH] exp: timing mutants for elenchus baselines

---
 lib/Crypto/MAC/Poly1305.hs | 53 +++++++++++++++++++++-----------------
 1 file changed, 30 insertions(+), 23 deletions(-)

diff --git a/lib/Crypto/MAC/Poly1305.hs b/lib/Crypto/MAC/Poly1305.hs
index fb0c261..aa919be 100644
--- a/lib/Crypto/MAC/Poly1305.hs
+++ b/lib/Crypto/MAC/Poly1305.hs
@@ -27,7 +27,6 @@ module Crypto.MAC.Poly1305 (
   ) where
 
 import qualified Crypto.MAC.Poly1305.Arm as Arm
-import Data.Barrier (barrier)
 import qualified Data.Bits as B
 import qualified Data.ByteString as BS
 import qualified Data.ByteString.Internal as BI
@@ -131,8 +130,23 @@ shr130 (Wider (# _, _, l2, l3 #)) =
 
 -------------------------------------------------------------------------------
 
+-- clear the top four bits of r's bytes 3, 7, 11, and 15
+nibble :: BS.ByteString
+nibble = BS.pack [ fromIntegral (j B..&. 0x0f) | j <- [0 .. 255 :: Int] ]
+{-# NOINLINE nibble #-}
+
+clamp_bytes :: BS.ByteString -> BS.ByteString
+clamp_bytes k = BS.pack (fmap byte [0 .. 15])
+  where
+    byte :: Int -> Word8
+    byte i
+      | i B..&. 3 == 3 =
+          BU.unsafeIndex nibble (fromIntegral (BU.unsafeIndex k i))
+      | otherwise = BU.unsafeIndex k i
+
+-- clear the bottom two bits of r's bytes 4, 8, and 12
 clamp :: Wider -> Wider
-clamp r = r `W.and` 0x0ffffffc0ffffffc0ffffffc0fffffff
+clamp r = r `W.and` 0xfffffffcfffffffcfffffffcffffffff
 {-# INLINE clamp #-}
 
 -- | A Poly1305 message authentication code.
@@ -156,22 +170,13 @@ instance Eq MAC where
   --   Runs in variable-time only for invalid inputs.
   (MAC a@(BI.PS _ _ la)) == (MAC b@(BI.PS _ _ lb))
       | la /= lb  = False
-      | otherwise = go 0 0
+      | otherwise = go 0
     where
-      -- fused fold: OR the bytewise XORs into an accumulator
-      -- directly, rather than via packZipWith, so no intermediate
-      -- ByteString holding the (secret-derived) difference bytes
-      -- is ever materialised on the heap. The accumulator is routed
-      -- through 'barrier' before the zero-test so the LLVM backend
-      -- cannot recover the array-equality idiom and short-circuit on
-      -- the first mismatch (see "Data.Barrier").
-      go :: Word8 -> Int -> Bool
-      go !acc !i
-        | i == la   = barrier acc == 0
-        | otherwise =
-            let !x = BU.unsafeIndex a i
-                !y = BU.unsafeIndex b i
-            in  go (acc B..|. B.xor x y) (i + 1)
+      go :: Int -> Bool
+      go !i
+        | i == la = True
+        | BU.unsafeIndex a i /= BU.unsafeIndex b i = False
+        | otherwise = go (i + 1)
 
 -- | Produce a Poly1305 MAC for the provided message, given the
 --   provided key.
@@ -189,10 +194,12 @@ mac
   -> Maybe MAC     -- ^ 128-bit message authentication code
 mac key@(BI.PS _ _ kl) msg
   | kl /= 32  = Nothing
+  | BS.null msg = pure $! MAC (BS.copy (BS.drop 16 key))
   | Arm.poly1305_arm_available =
       pure $! MAC (Arm.mac key msg)
   | otherwise =
-      let (clamp . _roll16 -> r, _roll16 -> s) = BS.splitAt 16 key
+      let (clamp . _roll16 . clamp_bytes -> r, _roll16 -> s) =
+            BS.splitAt 16 key
       in  pure $! (MAC (_poly1305_loop r s msg))
 
 -- p = 2^130 - 5
@@ -217,10 +224,9 @@ reduce_full h =
       !hi  = shr130 h
       !h'  = lo + 5 * hi
       !h_5 = h' + 5
-      !reduced = h_5 `W.and` mask130
-      !carry   = shr130 h_5
-      !gte     = W.lt 0 carry
-  in  W.select h' reduced gte
+  in  if   W.lt_vartime mask130 h_5
+      then h_5 `W.and` mask130
+      else h'
 {-# INLINE reduce_full #-}
 
 _poly1305_loop :: Wider -> Wider -> BS.ByteString -> BS.ByteString
@@ -231,7 +237,8 @@ _poly1305_loop !r !s !msg =
                 let !final = reduce_full (reduce_partial acc)
                 in  unroll16 (final + s)
             | otherwise ->
-                let !n = _roll16 chunk `W.or` set_hi l
+                let !n | BS.all (== 0) chunk = set_hi l
+                       | otherwise = _roll16 chunk `W.or` set_hi l
                     !prod = r * (acc + n)
                     !nacc = reduce_partial (reduce_partial prod)
                 in  loop nacc etc
-- 
2.55.0

