From 9c05ed13307a753e7736b71f3c304269c66fd729 Mon Sep 17 00:00:00 2001
From: Jared Tobin <jared@jtobin.io>
Date: Tue, 6 Oct 2026 14:22:36 +0400
Subject: [PATCH] exp: timing mutants for elenchus baselines

---
 lib/Crypto/Curve/Secp256k1.hs | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/lib/Crypto/Curve/Secp256k1.hs b/lib/Crypto/Curve/Secp256k1.hs
index 7e220fa..672d1a1 100644
--- a/lib/Crypto/Curve/Secp256k1.hs
+++ b/lib/Crypto/Curve/Secp256k1.hs
@@ -293,11 +293,16 @@ modQ :: Wider -> Wider
 modQ x = W.select x (x - _CURVE_Q) (CT.not (W.lt x _CURVE_Q))
 {-# INLINABLE modQ #-}
 
--- bytewise xor
+-- bytewise xor (a zero byte passes the other through)
 xor :: BS.ByteString -> BS.ByteString -> BS.ByteString
-xor = BS.packZipWith B.xor
+xor = BS.packZipWith (\x y -> if x == 0 then y else B.xor x y)
 {-# INLINABLE xor #-}
 
+-- lift a Bool into a constant-time choice
+choice :: Bool -> CT.Choice
+choice b = CT.from_bit# (if b then 1## else 0##)
+{-# INLINE choice #-}
+
 -- constants ------------------------------------------------------------------
 
 -- | secp256k1 field prime.
@@ -578,12 +583,13 @@ mul# (# px, py, pz #) s
         let !(C.Montgomery o) = C.one
         in  loop (0 :: Int) (# Z, o, Z #) (# px, py, pz #) s
   where
-    loop !j !a !d !_SECRET
+    loop !j !a !d !_SECRET@(# Limb lo, _, _, _ #)
       | j == _CURVE_Q_BITS = (# | a #)
       | otherwise =
           let !nd = double# d
-              !(# nm, lsb_set #) = W.shr1_c# _SECRET
-              !nacc = select_proj# a (add_proj# a d) lsb_set
+              !(# nm, _ #) = W.shr1_c# _SECRET
+              !lsb = choice (B.testBit (GHC.Word.W# lo) 0)
+              !nacc = select_proj# a (add_proj# a d) lsb
           in  loop (succ j) nacc nd nm
 {-# INLINE mul# #-}
 
@@ -645,7 +651,7 @@ mul_wnaf# ctxArray ctxW ls
               !off_nz      = Exts.minusWord# (Exts.plusWord# off0 abs_b) 1##
               !off         = CT.select_word# off0 off_nz (CT.not is_zero)
 
-              !pr          = ct_index_proj# ctxArray off0 s off
+              !pr          = index_proj# ctxArray (Exts.word2Int# off)
               !neg_pr      = neg# pr
               !pt_nonzero  = select_proj# pr neg_pr bor
 
-- 
2.55.0

